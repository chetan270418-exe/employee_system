# ==========================================================
# EmpTrack Environment Configuration Template
# ==========================================================
# Copy this file to '.env' and fill in your values:
# cp .env.example .env

# Flask Secret Key (used for session signing and CSRF tokens)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database Connection URL (MySQL format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>)
# NOTE: If your password contains special characters (like '@', ':', '/', '?'),
# you MUST URL-encode them. (Example: 'Chetan@27' becomes 'Chetan%4027')
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/employee_db

# Folder to store uploaded employee documents and payslips
UPLOAD_FOLDER=uploads

# Maximum file upload size in bytes (16777216 = 16 MB)
MAX_CONTENT_LENGTH=16777216
